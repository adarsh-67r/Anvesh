        {"text": "Discriminant of x²-4x+4=0?", "options": ["0", "4", "8", "-4"], "answer": "0"},
        {"text": "Sum of roots of x²-5x+6=0?", "options": ["5", "-5", "6", "-6"], "answer": "5"}
      ]
    }
  ]
}
