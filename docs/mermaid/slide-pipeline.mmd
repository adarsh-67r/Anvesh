flowchart LR
    ANS["📝 Student answers<br/>(quiz, practice)"] --> LOG["Event Logger<br/>answer + response time"]
    LOG --> ORC{"Orchestrator<br/>data per skill?"}
    ORC -->|"< 200 answers"| P0["Phase 0: EMA<br/>works from day 1"]
    ORC -->|"200+ answers"| P1["Phase 1: BKT<br/>Bayesian tracing"]
    ORC -->|"200+ answers, 10+ students"| P2["Phase 2: IRT<br/>2PL model"]
    P0 --> M["Mastery score<br/>per skill"]
    P1 --> M
    P2 --> M
    M --> REC["🎯 Next skills<br/>(prerequisites met)"]
    M --> RISK["⚠️ Dropout risk"]

    classDef input fill:#16a34a,stroke:#15803d,color:#fff
    classDef log fill:#0891b2,stroke:#0e7490,color:#fff
    classDef orch fill:#d97706,stroke:#b45309,color:#fff
    classDef phase fill:#2563eb,stroke:#1d4ed8,color:#fff
    classDef score fill:#7c3aed,stroke:#6d28d9,color:#fff
    classDef out fill:#16a34a,stroke:#15803d,color:#fff
    classDef risk fill:#dc2626,stroke:#b91c1c,color:#fff
    class ANS input
    class LOG log
    class ORC orch
    class P0,P1,P2 phase
    class M score
    class REC out
    class RISK risk
