flowchart LR
    subgraph APP["📱 Android App"]
        direction TB
        UI["Dashboard • Learning<br/>Flashcards • AI Tutor<br/>Timer • Quiz • Groups"]
        OFF["Offline Flashcard Cache<br/>(auto-sync)"]
    end

    subgraph SRV["☁️ FastAPI Backend (Render)"]
        direction TB
        SVC["Auth (JWT) • Flashcards (SM-2) • Todos<br/>Quiz Game • Study Groups (chat + files)<br/>AI Tutor (voice + photo/PDF)"]
        LOG["Event Logger"]
        subgraph REC["🧠 Recommendation Engine"]
            direction LR
            KG["Knowledge Graph<br/>(prerequisites)"] --> ORC["Orchestrator<br/>(auto phase)"]
            ORC --> P["Phase 0: EMA<br/>Phase 1: BKT<br/>Phase 2: IRT"]
            ORC -.-> FUT["Phase 3-4: DKT / MoE<br/>(future)"]
        end
        SVC --> LOG --> REC
    end

    subgraph EXT["External Services"]
        direction LR
        GEM["Google Gemini<br/>(AI tutor, quiz, voice)"]
        DB["Supabase<br/>PostgreSQL"]
    end

    APP -->|REST + JWT| SVC
    SVC -->|AI + data| EXT

    classDef app fill:#16a34a,stroke:#15803d,color:#fff
    classDef svc fill:#0891b2,stroke:#0e7490,color:#fff
    classDef rec fill:#2563eb,stroke:#1d4ed8,color:#fff
    classDef orch fill:#d97706,stroke:#b45309,color:#fff
    classDef ext fill:#7c3aed,stroke:#6d28d9,color:#fff
    classDef future fill:#6b7280,stroke:#9ca3af,stroke-dasharray: 5 5,color:#fff
    class UI,OFF app
    class SVC,LOG svc
    class KG,P rec
    class ORC orch
    class GEM,DB ext
    class FUT future
    style REC fill:#eff6ff,stroke:#3b82f6,stroke-width:2px,color:#111827
    style APP fill:#f0fdf4,stroke:#22c55e,color:#111827
    style SRV fill:#fefce8,stroke:#ca8a04,color:#111827
    style EXT fill:#f5f3ff,stroke:#7c3aed,color:#111827
