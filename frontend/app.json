{
  "expo": {
    "name": "Anvesh",
    "slug": "anvesh",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "anvesh",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arithi.anvesh"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.arithi.anvesh"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "Anvesh uses the microphone so you can ask the AI tutor questions by voice."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e2a5162-c06b-4e39-b7ed-410b3751e497"
      }
    },
    "owner": "adarsh67r"
  }
}
